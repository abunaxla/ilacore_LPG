{
  "name": "@ilacore/reader-sim",
  "version": "0.0.0",
  "private": true,
  "description": "RFID reader simulator behind the common reader interface",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "reader-sim": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sim": "node dist/cli.js"
  },
  "dependencies": {
    "@ilacore/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
