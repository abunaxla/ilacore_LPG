# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=3001
# Application login role: a member of lpg_app, never the superuser (so row-level security applies).
DATABASE_URL=postgres://lpg_app_login:change-me@127.0.0.1:15432/lpg_dev
# Schema owner, used only by `pnpm migrate`.
DATABASE_MIGRATION_URL=postgres://lpg_owner:change-me@127.0.0.1:15432/lpg_dev
# Integration tests: schema owner connection with CREATEDB/CREATEROLE. Each run creates a throwaway
# database from the lpg_template template (PostGIS preinstalled) and drops it afterwards.
# Leave unset to use a Testcontainers PostgreSQL instead (CI only; never Docker Desktop locally).
TEST_ADMIN_DATABASE_URL=postgres://lpg_owner:change-me@127.0.0.1:15432/lpg_dev
# 32 random bytes, base64. Encrypts MFA secrets at rest. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=change-me
