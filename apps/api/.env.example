# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=3001
# Application login role: a member of ilacore_app, never the superuser (so row-level security applies).
DATABASE_URL=postgres://ilacore_app_login:change-me@127.0.0.1:5432/ilacore
# Schema owner, used only by `pnpm migrate`.
DATABASE_MIGRATION_URL=postgres://ilacore:change-me@127.0.0.1:5432/ilacore
